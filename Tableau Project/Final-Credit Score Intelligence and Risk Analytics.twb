          <zone forceUpdate='true' h='10168' id='70' type-v2='text' w='24430' x='74933' y='88694'>
            <formatted-text>
              <run fontcolor='#adb241' fontname='Tableau Semibold'>🟢 </run>
              <run bold='true' fontcolor='#adb241' fontname='Tableau Semibold'>Active customers with credit cards show the lowest churn rate (13.9%), indicating stronger engagement and loyalty.</run>
            </formatted-text>
            <zone-style>
