          <zone forceUpdate='true' h='10168' id='71' type-v2='text' w='21484' x='53449' y='88694'>
            <formatted-text>
              <run fontcolor='#adb241' fontname='Tableau Semibold'>🟢 </run>
              <run bold='true' fontcolor='#adb241' fontname='Tableau Semibold'>Customers aged 31–40 form the largest customer segment and offer the greatest  retention opportunity.</run>
            </formatted-text>
            <zone-style>
