          <zone forceUpdate='true' h='10168' id='73' type-v2='text' w='22386' x='31063' y='88694'>
            <formatted-text>
              <run fontcolor='#f17b79' fontname='Tableau Semibold'>🔴 </run>
              <run bold='true' fontcolor='#f17b79' fontname='Tableau Semibold'>Germany records the highest churn, with female customers showing the greatest attrition rate (38%)</run>
