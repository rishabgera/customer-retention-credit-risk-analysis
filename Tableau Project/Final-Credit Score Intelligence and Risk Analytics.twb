    <worksheet name='Age and credit score Churn %'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#f17b79' fontname='Tableau Semibold' fontsize='12'>Age and Credit Score Impact on Churn</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='AgeandcreditscoreChurn' path='/workbooks/CreditScoreCustomerAnalyticsDashboard' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='Cleaned Bank Churn data' name='federated.0xg1m091g5p0bd1cy056n06h3g2f' />
          </datasources>
          <datasource-dependencies datasource='federated.0xg1m091g5p0bd1cy056n06h3g2f'>
            <column datatype='string' name='[Age Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[Balance]' role='measure' type='quantitative' />
            <column caption='credit score category' datatype='string' name='[Calculation_2125428290666498]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [CreditScore] &lt; 500  then   &quot;Poor (&lt;500)&quot;&#10;ELSEIF [CreditScore] &lt;650 then &quot;Fair (&lt;650)&quot;&#10;ELSEIF [CreditScore] &lt;750 THEN &quot;Good (&lt;750)&quot;&#10;ELSE &quot;Excellent (750 &amp; above)&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Excellent (750 &amp; above)&quot;' value='Excellent (&gt;750)' />
              </aliases>
            </column>
            <column caption='churn%' datatype='real' name='[Calculation_2125428364161029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Exited])/COUNT([Customer_Id])' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Credit Score' datatype='integer' name='[CreditScore]' role='measure' type='quantitative' />
            <column caption='Customer Id' datatype='integer' name='[Customer_Id]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Exited]' role='measure' type='quantitative' />
            <column-instance column='[Age Category]' derivation='None' name='[none:Age Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2125428290666498]' derivation='None' name='[none:Calculation_2125428290666498:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Balance]' derivation='Sum' name='[sum:Balance:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2125428364161029]' derivation='User' name='[usr:Calculation_2125428364161029:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xg1m091g5p0bd1cy056n06h3g2f].[none:Age Category:nk]'>
            <groupfilter function='level-members' level='[none:Age Category:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.0xg1m091g5p0bd1cy056n06h3g2f].[none:Calculation_2125428290666498:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Poor (&lt;500)&quot;</bucket>
              <bucket>&quot;Fair (&lt;650)&quot;</bucket>
              <bucket>&quot;Good (&lt;750)&quot;</bucket>
              <bucket>&quot;Excellent (750 &amp; above)&quot;</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.0xg1m091g5p0bd1cy056n06h3g2f].[none:Country:nk]</column>
            <column>[federated.0xg1m091g5p0bd1cy056n06h3g2f].[none:Age Category:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
