      <aliases enabled='yes' />
      <column datatype='real' name='[Balance]' role='measure' type='quantitative' />
      <column caption='Customer status' datatype='string' name='[Calculation_0032370757345280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Exited] = 1 THEN &quot;Exited&quot;&#10;&#10;ELSEIF [IsActiveMember] = 1 THEN &quot;Active&quot;&#10;&#10;ELSE &quot;Inactive&quot;&#10;END' />
      </column>
      <column caption='exit or not' datatype='string' name='[Calculation_0032370780229634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Exited] = 1 THEN &quot;🔴 Churned&quot;&#10;ELSE &quot;🟢 Retained&quot;&#10;END' />
      </column>
      <column caption='age distribution' datatype='string' name='[Calculation_2062347427749890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age]&lt;30 then &apos;&lt;30&apos;&#10;elseif  [Age] &lt;= 40 then &apos;31-40&apos;&#10;ELSEIF [Age] &lt;= 50 then &apos;41-50&apos;&#10;elseif  [Age] &lt;=60 then &apos;51-60&apos;&#10;ELSE &apos;&gt;60&apos;&#10;END' />
      </column>
      <column caption='is active(yes/no)' datatype='string' name='[Calculation_2062347490217987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IsActiveMember]=1 then   &apos;Active &apos;&#10;ELSE &apos;Inactive&apos;       &#10;END' />
      </column>
      <column caption='has Credit card yes/no' datatype='string' name='[Calculation_2062347490410500]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [HasCrCard]=1 then   &apos;Has Card&apos;&#10;else &apos;No Card&apos;&#10;END' />
      </column>
      <column caption='Revenue at risk' datatype='real' name='[Calculation_2062347745378309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Exited] = 1 then [Balance]&#10;ELSE 0 END' />
      </column>
      <column caption='Credit card adoption' datatype='real' name='[Calculation_2062347748487174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [HasCrCard] = 1 then [Customer_Id]&#10;END)/count([Customer_Id])' />
      </column>
      <column caption='credit card holders' datatype='integer' name='[Calculation_2062347749289991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [HasCrCard]=1 then [Customer_Id] END)' />
      </column>
      <column caption='% revenue at risk' datatype='real' name='[Calculation_2062347752718344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2062347745378309]/[Balance]' />
      </column>
      <column caption='No of customers' datatype='integer' name='[Calculation_2125428284878849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_Id])' />
      </column>
      <column caption='credit score category' datatype='string' name='[Calculation_2125428290666498]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CreditScore] &lt; 500  then   &quot;Poor (&lt;500)&quot;&#10;ELSEIF [CreditScore] &lt;650 then &quot;Fair (&lt;650)&quot;&#10;ELSEIF [CreditScore] &lt;750 THEN &quot;Good (&lt;750)&quot;&#10;ELSE &quot;Excellent (750 &amp; above)&quot;&#10;END' />
        <aliases>
          <alias key='&quot;Excellent (750 &amp; above)&quot;' value='Excellent (&gt;750)' />
        </aliases>
      </column>
      <column caption='churn%' datatype='real' name='[Calculation_2125428364161029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Exited])/COUNT([Customer_Id])' />
      </column>
      <column caption='Gender (Abb)' datatype='string' name='[Calculation_2125428367691782]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Gender]=&quot;Male&quot; then &quot;M&quot;&#10;else &quot;F&quot;&#10;END' />
      </column>
      <column caption='Inactive' datatype='integer' name='[Calculation_2125428569518089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Customer_Id])-SUM([IsActiveMember])' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Credit Score' datatype='integer' name='[CreditScore]' role='measure' type='quantitative' />
      <column caption='Customer Id' datatype='integer' name='[Customer_Id]' role='dimension' type='ordinal' />
      <column caption='Estimated Salary' datatype='real' name='[EstimatedSalary]' role='measure' type='quantitative' />
      <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
      <column caption='Is Active Member' datatype='integer' name='[IsActiveMember]' role='measure' type='quantitative' />
